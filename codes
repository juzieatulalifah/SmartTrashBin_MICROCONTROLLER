// ================== SETUP ==================
void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println("=========================================");
  Serial.println("Sistem Smart TPS Dual-Bot Dimulai...");
  Serial.println("=========================================");

  pinMode(TRIG_PENUH, OUTPUT);
  pinMode(ECHO_PENUH, INPUT);
  pinMode(TRIG_MANUSIA, OUTPUT);
  pinMode(ECHO_MANUSIA, INPUT);
  pinMode(PIR_PIN, INPUT);
  pinMode(LED, OUTPUT);

  servo.setPeriodHertz(50);
  servo.attach(SERVO_PIN, 500, 2400);
  servo.write(0);

  Wire.begin(21,22);
  lcd.init();
  lcd.backlight();
  lcd.setCursor(0,0);
  lcd.print("TPS Pasar Segiri");
  lcd.setCursor(0,1);
  lcd.print("Multi-Sensor ON");
  delay(2000);


  Serial.print("Menghubungkan ke Wi-Fi: ");
  WiFi.begin(SSID, PASS);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWi-Fi Terhubung!");

  Serial.print("Menyelaraskan waktu sertifikat SSL Telegram... ");
  configTime(8 * 3600, 0, "pool.ntp.org", "time.nist.gov"); 
  time_t now = time(nullptr);
  while (now < 24 * 3600) {
    delay(500);
    now = time(nullptr);
  }
  Serial.println("Waktu WITA Sinkron!");

  clientWarga.setInsecure(); 
  clientWarga.setHandshakeTimeout(30000); 
  clientStaff.setInsecure();
  clientStaff.setHandshakeTimeout(30000);

  Serial.println("Mengaktifkan integrasi Thinger.io...");
  thing.add_wifi(SSID, PASS);
  
  thing["monitor"] >> [](pson &out){
    out["kapasitas_persen"] = persentaseIsi;
    out["status_tps"] = statusTPS;
    out["status_servo"] = sudahTerbuka ? "BUKA" : "TUTUP";
  };

  thing["tombol_buka"] << [](pson& in){
    if(in.is_empty()){
      in = false; 
    } else {
      bool pressed = in;
      if(pressed) {
        modeManualThinger = true; 
        sudahTerbuka = true;
        Serial.println("🔘 [Thinger.io] Tombol MANUAL BUKA Ditekan!");
      }
    }
  };

thing["tombol_tutup"] << [](pson& in){
  if(in.is_empty()){
    in = false;
  } else {
    bool pressed = in;

    if(pressed) {

      modeManualThinger = false;

      servo.write(0);          // <-- tambahkan ini
      digitalWrite(LED, LOW); // <-- biar LED ikut mati

      sudahTerbuka = false;
      status_tutup = true;

      Serial.println("🔘 [Thinger.io] Tombol MANUAL TUTUP Ditekan!");
    }
   }
};
  Serial.println("Setup Selesai. Sistem Standby.");
  }

