// Fungsi cek jam operasional (18.00 s.d 06.00 WITA)
bool apakahJamOperasional() {
  time_t now = time(nullptr);
  struct tm* timeInfo = localtime(&now);
  int jamSekarang = timeInfo->tm_hour; 

  if (jamSekarang >= 18 || jamSekarang < 6) {
    return true;
  }
  return false;
}

// Fungsi format jam digital untuk laporan teks Telegram
String getWaktuSekarangStr() {
  time_t now = time(nullptr);
  struct tm* timeInfo = localtime(&now);
  char buf[10];
  sprintf(buf, "%02d:%02d", timeInfo->tm_hour, timeInfo->tm_min);
  return String(buf);
}

// Fungsi membaca sensor Ultrasonik
int bacaUltrasonik(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  
  long duration = pulseIn(echoPin, HIGH, 30000); 
  if (duration == 0) return 999; 
  return duration * 0.034 / 2;
}

